---
<BaseLayout
  title="MR-Compare · Changrui Zhu"
  description={projectDescription}
  image="/media/mr-compare/cover.png"
  structuredData={structuredData}
>
  <SiteHeader current="work" />
  <main id="main" class="project-page">
    <header class="project-hero project-paper-hero shell">
      <h1 data-reveal>MR-Compare</h1>
      <div class="project-paper-summary" data-reveal>
        <p class="kicker">Research publication</p>
        <p class="project-paper-title">A Mixed-Reality Framework for Spatially Grounded Visual Comparison of 3D Gaussian Splatting and Mesh Reconstructions with the Physical Environment</p>
        <p class="project-paper-status">IEEE ISMAR 2026 · TVCG Paper</p>
        <a class="project-paper-status project-paper-award" href="https://www.ieeeismar.net/2026/awards/" target="_blank" rel="noreferrer">Best Paper Award · Honorable Mention ↗</a>
        <p class="project-authors">
          <a href="mailto:changrui.zhu.19@ucl.ac.uk">Changrui Zhu</a><sup>1</sup>,
          <a href="mailto:ernst.kruijff@h-brs.de">Ernst Kruijff</a><sup>2</sup>,
          <a href="mailto:pengju.zhang.21@ucl.ac.uk">Pengju Zhang</a><sup>1</sup>,
          <a href="mailto:s.julier@ucl.ac.uk">Simon Julier</a><sup>1</sup>
        </p>
        <p class="project-affiliations"><sup>1</sup>University College London <span>·</span> <sup>2</sup>Hochschule Bonn-Rhein-Sieg</p>
      </div>
      <nav class="project-resource-links" aria-label="Project resources" data-reveal>
        <a class="project-resource-link" href="https://arxiv.org/abs/2607.20325" target="_blank" rel="noreferrer">
          <svg class="project-resource-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={arxivIcon} /></svg>
          <span>arXiv</span><span aria-hidden="true">↗</span>
        </a>
        <a class="project-resource-link" href="https://github.com/changruizhu96/MR-Compare" target="_blank" rel="noreferrer">
          <svg class="project-resource-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={githubIcon} /></svg>
          <span>Research repository</span><span aria-hidden="true">↗</span>
        </a>
        <a class="project-resource-link" href={xrToolkit.href} target="_blank" rel="noreferrer">
          <svg class="project-resource-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={githubIcon} /></svg>
          <span>Toolkit repository</span><span aria-hidden="true">↗</span>
        </a>
        <a class="project-resource-link" href="#abstract">
          <svg class="project-resource-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3H5v18h14V8z M14 3v5h5 M8 12h8 M8 16h8" /></svg>
          <span>Research overview</span><span aria-hidden="true">↓</span>
        </a>
        <a class="project-resource-link" href="#demo">
          <svg class="project-resource-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m10 8 6 4-6 4z" /></svg>
          <span>Demo</span><span aria-hidden="true">↓</span>
        </a>
      </nav>
      <div class="project-toolkit-note" data-reveal>
        <p><strong>Research repository</strong> — MR-Compare: the research reference implementation.</p>
        <p><strong>Toolkit repository</strong> — Unity XR 3DGS Toolkit: general-purpose Unity XR development and ongoing updates.</p>
      </div>
    </header>

    <figure class="project-figure project-figure-primary" data-reveal>
      <img src={`${base}/media/mr-compare/teaser.png`} alt="The MR-Compare end-to-end pipeline" width="3390" height="2173" />
      <figcaption>
        <span>MR-Compare registers mesh and 3D Gaussian Splatting reconstructions to the physical world, then supports in-headset visual comparison through a geometry-driven 3D Slider.</span>
        <a href={`${base}/media/mr-compare/teaser.png`} target="_blank" rel="noreferrer">Open full resolution ↗</a>
      </figcaption>
    </figure>

    <section class="project-academic-section shell section-rule" id="abstract">
      <header class="project-academic-heading" data-reveal><p class="kicker">01 · Paper</p><h2>Abstract</h2></header>
      <div class="project-prose" data-reveal>
        <p>MR-Compare is a spatially grounded mixed reality framework for comparing heterogeneous 3D reconstructions with the live physical world. Implemented on Meta Quest 3, the system aligns mesh and 3D Gaussian Splatting reconstructions to the headset's world coordinate system and enables cross-media comparison between reconstructed scenes and live video see-through.</p>
        <p>The paper evaluates MR-Compare through a real-world benchmark and an exploratory user study with 30 participants, covering practical desktop and mobile reconstruction workflows. The results show centimetre-level registration across tested workflows and strong visual consistency for desktop 3DGS-based reconstructions.</p>
      </div>
    </section>

    <section class="project-academic-section shell section-rule" id="demo">
      <header class="project-academic-heading" data-reveal><p class="kicker">02 · Media</p><h2>Demo</h2></header>
      <div class="project-prose" data-reveal>
        <h3 class="project-demo-title">Metric-scale reconstruction comparison</h3>
        <p>This demo uses reconstructions that are already at metric scale. They have been registered to the physical office, allowing the user to switch between the aligned reconstruction and the live environment, and to inspect the result with the 3D Slider.</p>
        <video class="project-video" controls muted playsinline preload="metadata" data-autoplay-on-view aria-label="MR-Compare office demonstration">
          <source src={`${base}/media/mr-compare/office-demo.mp4`} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <p class="project-media-caption">Final outcome demo: five registered reconstruction outputs aligned with the physical office, including standard 3DGS, RealityScan dense mesh, Scaniverse 3DGS splat, Polycam mesh, and 3DGS-MCMC. The demo shows switching between reconstructions and visualization with the 3D Slider.</p>
        <h3 class="project-demo-title" id="on-the-fly">Challenging case: non-metric 3DGS alignment</h3>
        <p>This challenging case combines a non-metric-scale 3DGS reconstruction with visible reconstruction artifacts. Using live headset depth scanning in on-the-fly mode, MR-Compare aligns the reconstruction with the physical environment despite the initial scale mismatch and imperfect reconstruction.</p>
        <video class="project-video" controls muted playsinline preload="none" data-autoplay-on-view width="1920" height="1080" poster={`${base}/media/mr-compare/on-the-fly-poster.jpg`} aria-label="MR-Compare on-the-fly alignment of a non-metric 3DGS reconstruction">
          <source src={`${base}/media/mr-compare/on-the-fly-demo.mp4`} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <p class="project-media-caption">On-the-fly depth scanning, scale estimation, and alignment, followed by comparison between the registered 3DGS reconstruction and video see-through (VST). The scanning segment is shown at 2× speed.</p>
      </div>
    </section>

    <section class="project-academic-section shell section-rule" id="method">
      <header class="project-academic-heading" data-reveal><p class="kicker">03 · Method</p><h2>System overview</h2></header>
      <div class="project-prose" data-reveal>
        <p>The teaser summarises MR-Compare as a single source-to-interaction pipeline. The system first converts heterogeneous reconstructions and headset observations into comparable point-cloud representations, then uses coarse-to-fine registration to place the reconstruction in the Quest world coordinate system before enabling in-headset visual comparison.</p>
        <ol class="project-method-list">
          <li><span>(a)</span><div><h3>Source point collection</h3><p>Each reconstruction is converted into a source point cloud: mesh vertices for mesh workflows and Gaussian centres for 3DGS workflows. For 3DGS, a zero-shot anisotropy filter prunes highly anisotropic Gaussians before their centres become source points. A radius crop and optional voxel-hash density filter then remove distant background content, skyboxes, and isolated floating points before registration.</p></div></li>
          <li><span>(b)</span><div><h3>Target point collection</h3><p>The Quest-side target cloud is built from the Meta Quest 3 Depth API. A point cloud generator raycasts screen-space samples into world-space points, while chunked storage and density caps keep the scan practical for in-headset use.</p></div></li>
          <li><span>(c)</span><div><h3>Coarse registration</h3><p>After voxelisation reduces density mismatch, FPFH-based correspondences provide a global initialisation. MR-Compare supports robust coarse estimators such as TEASER++ and TurboReg, producing an initial alignment between reconstruction and headset scan.</p></div></li>
          <li><span>(d)</span><div><h3>Fine registration</h3><p>The coarse transform is refined with G-ICP or V-GICP through the small_gicp backend. The resulting transform is persisted in the Quest world coordinate system so the aligned asset remains spatially grounded during comparison.</p></div></li>
          <li><span>(e)</span><div><h3>XR interactive comparison</h3><p>The final interface combines the registered reconstruction with live video see-through. A geometry-driven 3D Slider uses a movable volumetric alpha mask, letting users reveal reconstruction and physical-world content in the same spatial frame.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="project-academic-section shell section-rule" id="comparison">
      <header class="project-academic-heading" data-reveal><p class="kicker">04 · Output</p><h2>Visual comparison</h2></header>
      <div class="project-prose" data-reveal>
        <p>The system is designed for situations where the physical room is still accessible but the user also has reconstructed digital versions of that room. MR-Compare registers each reconstruction to the live MR coordinate system, so the user can inspect where a reconstruction agrees with, deviates from, or visually complements the current physical environment.</p>
        <figure class="project-inline-figure project-inline-figure-wide">
          <img src={`${base}/media/mr-compare/visual-comparison-overview.png`} alt="Two physical room views compared across five reconstruction workflows" width="4237" height="1374" loading="lazy" />
          <figcaption><span>High-resolution comparison from the paper: two physical viewpoints shown across the evaluated reconstruction workflows.</span><a href={`${base}/media/mr-compare/visual-comparison-overview.png`} target="_blank" rel="noreferrer">Open full resolution ↗</a></figcaption>
        </figure>
        <figure class="project-inline-figure project-inline-figure-wide project-inline-figure-detail">
          <img src={`${base}/media/mr-compare/visual-comparison-room-views.png`} alt="Expanded grid of registered comparison views across two rooms and five reconstruction workflows" width="4237" height="4501" loading="lazy" />
          <figcaption><span>Extended comparison across two rooms: additional viewpoints show reconstruction behaviour across local geometry, surfaces, and viewing directions.</span><a href={`${base}/media/mr-compare/visual-comparison-room-views.png`} target="_blank" rel="noreferrer">Open full resolution ↗</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="project-academic-section shell section-rule" id="evaluation">
      <header class="project-academic-heading" data-reveal><p class="kicker">05 · Evidence</p><h2>Evaluation</h2></header>
      <div class="project-prose" data-reveal>
        <p>The evaluation covers five representative reconstruction workflows: RealityScan mesh, Polycam mesh, desktop 3DGS, desktop 3DGS-MCMC, and Scaniverse 3DGS. The study combines objective registration and image-based consistency metrics with subjective ratings of perceived alignment, perceived visual consistency, usability, and cognitive workload.</p>
        <p>A second controlled Replica evaluation complements the real-world study. It uses eight NICE-SLAM Replica indoor scenes, reconstructs each scene with 3DGS and 3DGS-MCMC, and generates Quest-like target scans from the Replica meshes to isolate registration behaviour under reproducible conditions.</p>
        <p>In this setting, MR-Compare evaluates a zero-shot anisotropy filter for 3DGS source point selection. Sweeping the anisotropy threshold shows that moderate pruning can rescue failed registrations and reduce both translation and rotation error. The reported gains are larger for standard 3DGS, with reductions of 0.35 cm / 37.6% and 0.08 degrees / 38.7%, while 3DGS-MCMC improves by 0.12 cm / 16.9% and 0.04 degrees / 29.1%.</p>
        <p class="project-note">Evaluation figures are intentionally omitted from this version of the project page and can be added after the final paper assets are prepared.</p>
      </div>
    </section>

    <section class="project-academic-section shell section-rule" id="toolkit">
      <header class="project-academic-heading" data-reveal><p class="kicker">06 · Software</p><h2>Build with the toolkit</h2></header>
      <div class="project-prose" data-reveal>
        <p><strong>{xrToolkit.name}</strong> maintains and extends the Unity XR/3DGS tools developed for MR-Compare. It brings the renderer, scene preparation, physical-environment scanning, registration, and comparison controls into a complete Unity project that can be adapted to other XR applications.</p>
        <p>The separate MR-Compare research repository includes post-paper maintenance updates; it is not an exact snapshot of the version evaluated in the paper.</p>
        <p><strong>3DGS in VR.</strong> Import a 3D Gaussian Splatting reconstruction and render it in an XR scene. This path does not require a room scan or physical-world registration.</p>
        <p><strong>Spatially registered MR.</strong> Use the included Room Scanner and Alignment Demo scenes to align 3DGS or mesh reconstructions with a physical room. The toolkit supports scale estimation for non-metric sources, alignment save/load, and Mini-Window, 3D Slider, and Switch-back comparison modes.</p>
        <p>The current tested setup is Windows PC + Meta Quest Link. For MR registration, start with a reconstruction of the same indoor room at metric scale, or enable scale estimation. The repository documents setup requirements and the available scanning and alignment workflows.</p>
        <nav class="project-resource-links" aria-label="Toolkit resources">
          <a class="project-resource-link" href={xrToolkit.href} target="_blank" rel="noreferrer">Toolkit repository ↗</a>
          <a class="project-resource-link" href={`${xrToolkit.href}#vr-quick-start`} target="_blank" rel="noreferrer">VR quick start ↗</a>
          <a class="project-resource-link" href={`${xrToolkit.href}#mr-registration`} target="_blank" rel="noreferrer">MR quick start ↗</a>
        </nav>
      </div>
    </section>

    <section class="project-academic-section shell section-rule" id="citation">
      <header class="project-academic-heading" data-reveal><p class="kicker">07 · Record</p><h2>Citation</h2></header>
      <div class="project-prose" data-reveal>
        <p><a class="text-link" href="https://arxiv.org/abs/2607.20325" target="_blank" rel="noreferrer">arXiv:2607.20325 <span aria-hidden="true">↗</span></a></p>
        <p class="project-citation-label">BibTeX</p>
        <pre class="project-bibtex"><code>{bibtex}</code></pre>
      </div>
    </section>

  </main>
  <footer class="site-footer shell"><p>Changrui Zhu</p><a href={`${base}/`}>Back to index ↑</a><p>© {new Date().getFullYear()}</p></footer>
  <script>
    const demoVideos = document.querySelectorAll<HTMLVideoElement>("[data-autoplay-on-view]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!reducedMotion.matches) {
      const autoplayObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const demoVideo = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) void demoVideo.play().catch(() => {});
          else demoVideo.pause();
        }
      }, { threshold: 0.5 });

      demoVideos.forEach((demoVideo) => autoplayObserver.observe(demoVideo));
    }
  </script>
</BaseLayout>
