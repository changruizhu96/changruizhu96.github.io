const bibtex = `@misc{zhu2026mrcompare,
      title={MR-Compare: A Mixed-Reality Framework for Spatially Grounded Visual Comparison of 3D Gaussian Splatting and Mesh Reconstructions with the Physical Environment},
      author={Changrui Zhu and Ernst Kruijff and Pengju Zhang and Simon Julier},
      year={2026},
      eprint={2607.20325},
      archivePrefix={arXiv},
      primaryClass={cs.GR},
      url={https://arxiv.org/abs/2607.20325},
}`;
const projectDescription = "MR-Compare is a mixed-reality framework for spatially grounded visual comparison of 3D Gaussian Splatting and mesh reconstructions with the physical environment.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "MR-Compare",
  description: projectDescription,
  url: "https://changruizhu96.github.io/work/mr-compare/",
  codeRepository: "https://github.com/changruizhu96/MR-Compare",
  programmingLanguage: "C#",
  runtimePlatform: ["Unity 6000", "OpenXR", "Meta Quest"],
  license: "https://opensource.org/license/mit",
  citation: "https://arxiv.org/abs/2607.20325",
  author: { "@type": "Person", name: "Changrui Zhu", url: "https://changruizhu96.github.io/" },
