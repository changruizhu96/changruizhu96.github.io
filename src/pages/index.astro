---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SpatialField from "../components/SpatialField.astro";
import { publications, researchCoordinates, site } from "../data/site";
---
<BaseLayout>
  <SiteHeader />
  <main id="main">
    <section class="hero shell">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow"><span>Research coordinate</span><span>51.5246° N · 0.1340° W</span></p>
        <h1>{site.statement}</h1>
        <div class="hero-bottom"><p>{site.introduction}</p><a class="text-link" href="#work">Enter the work <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="hero-visual" data-reveal><SpatialField /></div>
      <p class="hero-index" aria-hidden="true">00—26</p>
    </section>

    <section class="coordinates shell section-rule" aria-labelledby="coordinates-title">
      <div class="section-heading" data-reveal><p class="kicker">Research coordinates</p><h2 id="coordinates-title">One question,<br />three viewpoints.</h2></div>
      <div class="coordinate-list">
        {researchCoordinates.map((item) => <article class="coordinate" data-reveal><span>{item.index}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </section>

    <section class="featured shell section-rule" id="work" aria-labelledby="work-title">
      <div class="section-heading compact" data-reveal><p class="kicker">Selected system · 2026</p><h2 id="work-title">MR-Compare</h2></div>
      <a class="work-visual" href="/work/mr-compare/" data-reveal aria-label="Read the MR-Compare project story">
        <img src="/media/mr-compare/teaser.jpg" alt="MR-Compare mixed-reality registration and comparison pipeline" width="1600" height="720" loading="lazy" />
        <span class="work-tag tag-one">Physical world</span><span class="work-tag tag-two">Registered model</span><span class="work-cursor" aria-hidden="true">↗</span>
      </a>
      <div class="work-summary" data-reveal>
        <p class="work-lead">A mixed-reality framework for comparing heterogeneous 3D reconstructions directly against the physical world.</p>
        <div><p>Registration · 3DGS · Interaction</p><p>Meta Quest 3 · 30-participant study</p><a class="text-link" href="/work/mr-compare/">Explore the project <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="publications shell section-rule" id="publications" aria-labelledby="publications-title">
      <div class="section-heading" data-reveal><p class="kicker">Selected publications</p><h2 id="publications-title">Evidence,<br />not inventory.</h2></div>
      <div class="publication-list">
        {publications.map((publication, index) => (
          <a class="publication" href={publication.href} target="_blank" rel="noreferrer" data-reveal>
            <span class="publication-number">0{index + 1}</span><div><p class="publication-venue">{publication.venue}</p><h3>{publication.title}</h3><p class="publication-authors">{publication.authors}</p></div><span class="publication-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
        <a class="text-link publication-more" href="https://scholar.google.com/citations?user=gjFTZ9EAAAAJ" target="_blank" rel="noreferrer">View the full record <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="about shell section-rule" id="about" aria-labelledby="about-title">
      <div class="portrait-wrap" data-reveal><img src="/media/portrait.jpeg" alt="Changrui Zhu" width="900" height="900" loading="lazy" /><span>Researcher / builder / observer</span></div>
      <div class="about-copy" data-reveal>
        <p class="kicker">About the researcher</p><h2 id="about-title">I move between code, experiments, and lived spatial experience.</h2>
        <p>I am a PhD researcher at University College London, supervised by Prof. Simon Julier. Before UCL, I studied Electronic and Electrical Engineering at the University of Glasgow.</p>
        <p>My work joins Unity-based VR/MR development with 3D reconstruction, registration, and controlled user studies. Away from research, photography shapes how I observe space, light, and change.</p>
        <div class="link-row">{site.links.map((link) => <a class="text-link" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>
      </div>
    </section>
  </main>
  <footer class="site-footer shell"><p>{site.name}</p><p>{site.role}</p><p>© {new Date().getFullYear()}</p></footer>
</BaseLayout>
