---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ChangeBlindnessTest from "../components/ChangeBlindnessTest.astro";
import { publications, site } from "../data/site";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const recentPublications = publications.slice(0, 3);
---
<BaseLayout>
  <SiteHeader />
  <main id="main">
    <section class="hero shell profile-hero" id="about" aria-labelledby="profile-title">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow"><span>PhD researcher · UCL</span><span>London, UK</span></p>
        <div class="hero-identity">
          <h1 class="hero-name" id="profile-title">{site.name}</h1>
          <p class="hero-role">Spatial computing · Extended reality · Cognitive science · 3D vision</p>
          <p class="hero-focus">{site.introduction}</p>
          <p class="hero-focus">I am a PhD researcher at University College London, supervised by Prof. Simon Julier. Before UCL, I studied Electronic and Electrical Engineering at the University of Glasgow.</p>
        </div>
        <div class="link-row">{site.links.map((link) => <a class="text-link" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>
      </div>
      <div class="portrait-wrap profile-portrait" data-reveal><img src={`${base}/media/portrait.jpeg`} alt="Changrui Zhu" width="900" height="900" loading="eager" /><p class="hero-statement">{site.statement}</p></div>
    </section>

    <section class="featured shell section-rule" id="work" aria-labelledby="work-title">
      <div class="work-grid">
        <div class="work-copy" data-reveal>
          <p class="kicker">Selected work</p>
          <h2 id="work-title">MR-Compare</h2>
          <p class="work-lead">A mixed-reality framework for spatially grounded visual comparison of 3D Gaussian Splatting and mesh reconstructions with the physical environment.</p>
          <div class="work-recognition">
            <p>IEEE ISMAR 2026 · TVCG Paper</p>
            <a href="https://www.ieeeismar.net/2026/awards/" target="_blank" rel="noreferrer">Best Paper Award · Honorable Mention ↗</a>
          </div>
          <div class="work-meta">
            <p>Registration · 3DGS · Interaction</p>
            <p>Meta Quest 3 · 30-participant study</p>
          </div>
          <a class="text-link" href={`${base}/work/mr-compare/`}>Explore the project <span aria-hidden="true">↗</span></a>
        </div>
        <a class="work-visual work-visual-concept" href={`${base}/work/mr-compare/`} data-reveal aria-label="Read the MR-Compare project story">
          <img src={`${base}/media/mr-compare/cover.png`} alt="Conceptual diagram of MR-Compare connecting the physical world, 3D Gaussian Splatting, and video see-through" width="1129" height="1128" loading="eager" />
        </a>
      </div>
    </section>

    <section class="featured shell section-rule" aria-labelledby="change-detection-title">
      <div class="work-grid">
        <div class="work-copy" data-reveal>
          <p class="kicker">Selected work</p>
          <h2 id="change-detection-title">Learning from Edits for Online Scene Change Detection</h2>
          <p class="work-lead">Learn what change looks like from automatic 3D Gaussian edits, then update the evidence as new views arrive.</p>
          <div class="work-meta">
            <p>3D Gaussian Splatting · Bayesian inference</p>
            <p>Changrui Zhu · Simon Julier</p>
          </div>
          <a class="text-link" href={`${base}/work/lego-scd/`}>Explore the project <span aria-hidden="true">↗</span></a>
        </div>
        <a class="work-visual work-visual-concept change-cover" href={`${base}/work/lego-scd/`} data-reveal aria-label="Explore learning from edits for online scene change detection">
          <img src={`${base}/media/learning-from-edits/cover.png`} alt="Offline learning from reference edits and change labels, followed by online fusion of current evidence, 3D history and the scene prior to detect changes" width="1200" height="900" loading="lazy" />
        </a>
      </div>
    </section>

    <section class="home-publications shell section-rule" id="publications" aria-labelledby="publications-title">
      <header class="home-publications-header" data-reveal>
        <div><p class="kicker">Publication collection</p><p class="archive-count">Latest three records</p></div>
        <div class="home-publications-heading"><h2 id="publications-title">Recent publications</h2><a class="text-link" href={`${base}/publications/`}>View all publications <span aria-hidden="true">↗</span></a></div>
      </header>
      <div class="home-publication-list">
        {recentPublications.map((publication) => (
          <a class="home-publication-entry" href={publication.href} target="_blank" rel="noreferrer" data-reveal aria-label={`Open ${publication.title}`}>
            <p class="home-publication-meta"><span>{publication.year}</span><span>{publication.venue}</span><span>{publication.kind}</span></p>
            <div><h3>{publication.title}</h3>{publication.award && <p class="entry-meta"><span>{publication.award}</span></p>}<p>{publication.authors}</p></div>
            <span class="home-publication-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-game shell section-rule" aria-labelledby="game-title">
      <header><p class="kicker">Attention · Memory · Perception</p><h2 id="game-title">Can you spot the change?</h2></header>
      <div class="hero-visual" data-reveal><ChangeBlindnessTest /></div>
    </section>
  </main>
  <footer class="site-footer shell"><p>{site.name}</p><p>{site.role}</p><p>© {new Date().getFullYear()}</p></footer>
</BaseLayout>

<style>
  .profile-hero { grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr); align-items: center; min-height: auto; }
  .profile-hero .hero-identity { margin: 2.5rem 0 0; }
  .profile-hero .hero-focus { max-width: 650px; }
  .profile-portrait { width: 100%; }
  .profile-portrait .hero-statement { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .home-game { max-width: 760px; }
  .home-game header { margin-bottom: 2rem; }
  .home-game h2 { margin: 1rem 0 0; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 500; letter-spacing: -.05em; line-height: 1.1; }
  @media (max-width: 900px) { .profile-hero { grid-template-columns: 1fr; } .profile-portrait { max-width: 320px; } }
</style>
